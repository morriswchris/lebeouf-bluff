{
  "name": "lebeoufs-bluff",
  "version": "1.0.0",
  "description": "Scorekeeper for Lebeouf's Bluff",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/app.jsx --bundle --minify --format=iife --target=es2018 --define:process.env.NODE_ENV=\\\"production\\\" --outfile=app.js",
    "watch": "esbuild src/app.jsx --bundle --format=iife --target=es2018 --define:process.env.NODE_ENV=\\\"development\\\" --outfile=app.js --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
